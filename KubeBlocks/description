curl -s https://api.github.com/repos/apecloud/kubeblocks/releases/latest | jq -r '.tag_name'

kubectl create -f https://github.com/apecloud/kubeblocks/releases/download/v1.0.2/kubeblocks_crds.yaml
helm repo add kubeblocks https://apecloud.github.io/helm-charts
helm repo update

helm install kubeblocks kubeblocks/kubeblocks --namespace kb-system --create-namespace --version=v1.0.2
